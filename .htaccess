# 호스팅(Apache) 이전용 설정 — GitHub Pages에서는 무시됨
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType image/webp .webp

# 보안 헤더 (알파컴 Apache에서만 적용, GitHub Pages는 무시)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header unset X-Powered-By
  # [SSL 설치 확인 후 주석 해제] 브라우저가 항상 https로 접속하게 함
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
ServerSignature Off

# 숨김 파일(.git, .env 등)과 작업용 파일 접근 차단 (.well-known은 SSL 발급용이라 허용)
RedirectMatch 404 ^/(?!\.well-known/)\..*$
<FilesMatch "\.(md|py|sh|bak|old|orig|swp|log|ini|sql|env|conf)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # [SSL 설치 확인 후 주석 해제] http → https
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # agrow.co.kr → www.agrow.co.kr (주소 하나로 통일)
  RewriteCond %{HTTP_HOST} ^agrow\.co\.kr$ [NC]
  RewriteRule ^(.*)$ https://www.agrow.co.kr/$1 [L,R=301]

  # 옛 XE 주소 → 새 페이지 (검색·즐겨찾기 링크 보존)
  RewriteRule ^index\.php$ /? [L,R=301]
  RewriteRule ^products/?$ /#products [L,R=301,NE]
  RewriteRule ^(intro|about|company|agrow_info)/?$ /#about [L,R=301,NE]
  RewriteRule ^(help|faq|as|support|notice)/?$ /#contact [L,R=301,NE]

  # 옛 사이트 보관 폴더는 외부 접근 차단
  RewriteRule ^old(/|$) - [F,L]

  # 이 홈페이지는 PHP를 쓰지 않음: 서버에 남은 옛 XE 파일이나 누가 몰래 올린 파일이 있어도 실행되지 않게 모든 서버 스크립트 차단
  # (나중에 PHP 관리자 페이지를 만들면 그 파일만 예외로 추가)
  RewriteRule \.(php[0-9]?|phtml|phar|pht|inc|cgi|pl|py|asp|aspx|jsp|sh)$ - [F,L,NC]
  # 압축 파일은 downloads 폴더(PC 프로그램)만 허용: 서버에 남은 백업 압축본(사이트 통째 백업 등) 유출 방지
  RewriteRule ^(?!downloads/).+\.(zip|tar|gz|tgz|7z|rar|bak|sql)$ - [F,L,NC]
  # 옛 XE(그누보드 계열 포함) 폴더 경로 차단: 파일이 남아 있어도 접근 불가
  RewriteRule ^(modules|addons|layouts|m\.layouts|widgets|widgetstyles|files|common|classes|config|libs|install|admin|xe|bbs|board|data|plugin|adm|wp-admin|wp-content|wp-includes|phpmyadmin|pma)(/|$) - [F,L,NC]
</IfModule>
