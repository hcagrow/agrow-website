# 호스팅(Apache) 이전용 설정 — GitHub Pages에서는 무시됨
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # [SSL 설치 확인 후 주석 해제] http → https
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # agrow.co.kr → www.agrow.co.kr (주소 하나로 통일)
  RewriteCond %{HTTP_HOST} ^agrow\.co\.kr$ [NC]
  RewriteRule ^(.*)$ http://www.agrow.co.kr/$1 [L,R=301]

  # 옛 XE 주소 → 새 페이지 (검색·즐겨찾기 링크 보존)
  RewriteRule ^index\.php$ /? [L,R=301]
  RewriteRule ^products/?$ /#products [L,R=301,NE]
  RewriteRule ^(intro|about|company|agrow_info)/?$ /#about [L,R=301,NE]
  RewriteRule ^(help|faq|as|support|notice)/?$ /#contact [L,R=301,NE]

  # 옛 사이트 보관 폴더는 외부 접근 차단
  RewriteRule ^old(/|$) - [F,L]
</IfModule>
